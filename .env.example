# Copy this file to `.env` and fill in the real values.
# The `.env` file is gitignored and must never be committed.

# MariaDB connection string for Prisma (see docs/install_mariadb_with_docker.txt)
DATABASE_URL="mysql://root:password@localhost:3306/ecommerce"

# better-auth (run `npx @better-auth/cli secret` to generate a strong secret)
BETTER_AUTH_SECRET=

# Base URL of your app
BETTER_AUTH_URL=http://localhost:3000

# Resend (Contact Us feature — https://resend.com)
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
